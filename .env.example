# 必填：阿里云百炼
DASHSCOPE_API_KEY=sk-your-key
# 推荐填写北京地域业务空间 ID；新专属域名的 L0/L1/L2 都需要它
DASHSCOPE_WORKSPACE_ID=

# L0 | L1 | L2 | L3，一行切换；默认先用 L3 验证全链路
VOICE_MODE=L3
VOICE_AUTO_FALLBACK=true

# 文本模型与报告模型
QWEN_TEXT_MODEL=qwen-plus
QWEN_REPORT_MODEL=qwen-plus
QWEN_REALTIME_MODEL=qwen3.5-omni-flash-realtime
OMNI_TRANSCRIPTION_MODEL=qwen3-asr-flash-realtime
# 安静笔记本麦克风的默认灵敏度；环境噪声大时可调高
OMNI_VAD_THRESHOLD=0.35
OMNI_SILENCE_DURATION_MS=800
VOICE_DIAGNOSTICS_LOG_LEVEL=INFO

# L1/L2
PARAFORMER_MODEL=paraformer-realtime-v2
COSYVOICE_MODEL=cosyvoice-v3-flash
COSYVOICE_VOICE=longanyang
EDGE_TTS_VOICE=zh-CN-YunxiNeural

# 可选：仅在需要覆盖默认北京地域地址时填写
# DASHSCOPE_BASE_URL=https://your-workspace.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_REALTIME_URL=wss://your-workspace.cn-beijing.maas.aliyuncs.com/api-ws/v1/realtime
# DASHSCOPE_ASR_URL=wss://your-workspace.cn-beijing.maas.aliyuncs.com/api-ws/v1/inference
# COSYVOICE_URL=wss://your-workspace.cn-beijing.maas.aliyuncs.com/api-ws/v1/inference

HOST=0.0.0.0
PORT=8000
DB_PATH=./data/interviews.db
# Docker Compose + Caddy 公网 HTTPS 使用（先把 DNS A 记录指向服务器）
DOMAIN=interview.example.com
MAX_PDF_MB=8
LLM_TIMEOUT_SECONDS=90
# 公网预算保险丝（按 UTC 自然日）；到限额后拒绝新开面试
DAILY_INTERVIEW_LIMIT=20
CLIENT_DAILY_INTERVIEW_LIMIT=5
PRESSURE_INTERRUPT_SECONDS=4

# 无 Key 的离线 UI/状态机演示。正式部署请保持 false。
MOCK_LLM=false
