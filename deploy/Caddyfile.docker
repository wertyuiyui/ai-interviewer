{$DOMAIN} {
    encode zstd gzip

    reverse_proxy app:8000 {
        flush_interval -1
        transport http {
            dial_timeout 10s
            response_header_timeout 120s
            read_timeout 30m
            write_timeout 30m
        }
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }
}
